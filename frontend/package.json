{
  "name": "it-tools",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node --test test/smoke.test.mjs",
    "test:e2e": "playwright test",
    "test:perf": "node test/perf/load-test.mjs",
    "test:lcp": "node test/perf/lcp-audit.mjs",
    "test:memory": "node test/perf/memory-leak-audit.mjs",
    "test:a11y": "node test/perf/a11y-audit.mjs",
    "test:all": "npm run test && npm run test:e2e && npm run test:lcp && npm run test:memory && npm run test:a11y",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "ibantools": "^4.5.4",
    "libphonenumber-js": "^1.13.14",
    "mathjs": "^15.2.0",
    "next": "^16.3.8",
    "oui-data": "^2.1.35",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.3",
    "autocannon": "^8.0.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.3"
  }
}
